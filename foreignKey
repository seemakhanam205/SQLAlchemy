from sqlalchemy import ForeignKey, create_engine, MetaData, Table, Column, String, Integer, Float
engine=create_engine('postgresql+psycopg://postgres:seema_223@localhost:5432/mydatabase',echo=True)

meta=MetaData()

people=Table(
    "people", #Name of the table 
    meta,
    Column('id',Integer, primary_key=True),
    Column('name',String, nullable=False),
    Column('age',Integer)
)

things = Table(
    "things",
    meta,
    Column('id',Integer,primary_key=True),
    Column('description', String, nullable=False),
    Column('value',Float),
    Column('owner',Integer, ForeignKey('people.id'))

)

meta.create_all(engine)  #creates all the table (even when more than one table is created)
conn=engine.connect()

